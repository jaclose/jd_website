# Supabase (optional — the site runs from local content without these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Signals: Strava native activity
# Create a Strava API app, authorize it with activity:read, then store the refresh token here.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
STRAVA_ACTIVITY_LIMIT=5

# Signals: Spotify native now-playing / recently-played
# Refresh token must include user-read-currently-playing and user-read-recently-played scopes.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Confirmed email subscriptions — see docs/email-system.md.
# Server secrets; never use NEXT_PUBLIC_ for these values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=notes@jafardabbagh.com
RESEND_FROM_NAME=Jafar Dabbagh
SEGMENT_ESSAYS_ID=
SEGMENT_FIELDNOTES_ID=
SEGMENT_DEPLOYMENTS_ID=
TOPIC_ESSAYS_ID=
TOPIC_FIELDNOTES_ID=
TOPIC_PROJECTS_ID=
NEXT_PUBLIC_SITE_URL=https://www.jafardabbagh.com
# Preview deployments refuse email unless explicitly enabled for an isolated test account.
NEWSLETTER_ALLOW_PREVIEW=false
# Render one explicitly selected publication; no provider calls.
DRY_RUN_EMAILS=false
