# Supabase (optional — the site runs from local content without these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Signals — full walkthrough in docs/signals-setup.md; verify with `npm run signals:check`
# Strava: create an app (callback domain: localhost), then `npm run strava:token` writes the refresh token.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
STRAVA_ACTIVITY_LIMIT=5

# Spotify: redirect URI http://127.0.0.1:8888/callback, then `npm run spotify:token`.
# Spotify ends the authorization after 6 months — re-run the helper before then.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Optional: Upstash Redis (Vercel → Storage) persists rotated Strava refresh tokens.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Email list — Resend Broadcasts (see docs/email-system.md)
# Never expose RESEND_API_KEY client-side; it's read only in server routes/scripts.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notes@jafardabbagh.com
RESEND_FROM_NAME=Jafar Dabbagh
SEGMENT_ESSAYS_ID=
SEGMENT_FIELDNOTES_ID=
RESEND_TOPIC_ID=
# Guards POST /api/broadcast/new-publication so only trusted callers can email the list.
PUBLISH_WEBHOOK_SECRET=
# Canonical origin used in emails (falls back to the site URL constant if unset).
NEXT_PUBLIC_SITE_URL=https://www.jafardabbagh.com
# Set true to render emails without calling Resend (preview to /tmp/email-preview.html).
DRY_RUN_EMAILS=
